{
  "name": "peekaboo-pals",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "backend": "cargo run --manifest-path backend/Cargo.toml",
    "speech": "node --env-file=.env scripts/generate-speech.mjs"
  },
  "dependencies": {
    "lucide-preact": "^0.468.0",
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.3",
    "@types/node": "^22.10.5",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  }
}
