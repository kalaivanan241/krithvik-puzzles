# Copy to .env and fill in. .env is ignored by Git and Docker builds.
# Read by the Rust backend (local runs), Docker Compose, and `npm run speech`.

# --- ElevenLabs voice clips (see README "Voice Clips") ---
# Needs text-to-speech permission. Without it, saves still work but are silent.
ELEVEN_LABS_API_KEY=
# Matilda (warm, friendly). Alternatives on free plans: Lily pFZP5JQG7iQjIQuC4Bku,
# Sarah EXAVITQu4vr4xnSDxMaL. After changing, run `npm run speech -- --force`.
ELEVEN_LABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX
ELEVEN_LABS_MODEL_ID=eleven_multilingual_v2

# --- Admin access for parent management and MCP ---
# Optional fixed token (16+ characters). Leave empty to use the generated
# backend/data/peekaboo.admin-token.
ADMIN_TOKEN=

# --- Remote MCP (for example, a claude.ai custom connector) ---
# Public HTTPS origin of this app, such as https://games.example.com (no path).
# Enables OAuth sign-in for MCP and allows this host. Empty keeps MCP local-only.
PUBLIC_URL=
# Extra public hostnames allowed to reach /mcp, comma-separated, without scheme
# or wildcards. Not needed for the PUBLIC_URL host.
MCP_ALLOWED_HOSTS=

# --- Docker Compose ---
# Host port on 127.0.0.1 for the app container.
APP_PORT=8089
# Log level; unset locally keeps the default "info,tower_http=debug".
# RUST_LOG=info

# --- Local (non-Docker) backend only; Docker sets its own paths ---
# BIND_ADDR=127.0.0.1:3001
# DATABASE_PATH=backend/data/peekaboo.sqlite
# UPLOAD_DIR=backend/data/uploads
# FRONTEND_DIST=dist
